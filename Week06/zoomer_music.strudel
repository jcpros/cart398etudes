//@title zoomer music
//@by clarence

samples('github:jcpros/samples')

samples({
  break:'https://cdn.freesound.org/previews/260/260050_450294-lq.mp3',
  //https://freesound.org/people/JohnLaVine333/sounds/260050/
  drumLoop: 'https://cdn.freesound.org/previews/251/251290_3162775-lq.mp3',
  //https://freesound.org/people/zagi2/sounds/251290/
  crackle: 'https://cdn.freesound.org/previews/27/27474_181367-lq.mp3',
  //https://freesound.org/people/EcoDTR/sounds/27474/
  click: 'https://cdn.freesound.org/previews/387/387799_4062622-lq.mp3',
  //https://freesound.org/people/Jagadamba/sounds/387799/
  pop: ['https://cdn.freesound.org/previews/784/784040_5287430-lq.mp3',
        'https://cdn.freesound.org/previews/789/789790_6368615-lq.mp3'],  
  //https://freesound.org/people/Sadiquecat/sounds/784040/
  //https://freesound.org/people/quatricise/sounds/789790/
  clp: 'https://cdn.freesound.org/previews/533/533576_1847035-lq.mp3',
  //https://freesound.org/people/Saltbearer/sounds/533576/
  amen: 'https://cdn.freesound.org/previews/260/260050_450294-lq.mp3'
  //https://freesound.org/people/JohnLaVine333/sounds/260050/
})
setcps(140/60/4)


//bass, very unsure about it
$: note("<[[1 [~ 1]][~ 1*2][1*2][[1|6|8]*2]] [[1 [~ 1]][~ 1][1][1*2]]>").sound("user")
  .partials([1,0,1,0,1,0,1])
  .adsr("0:0.2:0:0")
  .fm("1").fmh("4").fmdecay("0.5")
  .dist(2).distorttype("chebyshev")
  .scale("f1:enigmatic")
  .orbit(2).room(0.8)
  .struct("x x [x [~ x]] [~ x]").octave(-1)
  //.ply(2)
  .gain(0.05)


//clap
$: sound("compurhythm1000_cp").struct("[~][x][~][x]") 
  .speed(2)
  //.fast("<2!2 4!2>") quand le parté est pogné
  .orbit(3).dfb(0.5).dt(0.02).delay(0.5).room(1).roomsize(0.4).roomfade(2)
  .gain(0.4).degradeBy(0)

// car saw
$: note("[~][6*2][~ 6][~ [5 4*3]]").sound("supersaw").lpf(1000).adsr("0.2:0.3:0:0.2")
  .orbit(2).roomsize(0.2).roomfade(2).room(0.9)
  .detune(2)
  .scale("f4:enigmatic")
  .pan(perlin.segment(16).range(0.2,0.8))
.gain(0.9)


// tom drive
$: sound("drumLoop").slice(8,"1 2 3 4 1 2 3 4").cut(1).clip(0.7)
  .speed(2)
  .hpf("<1000 800 500 300>/2")
  //.hpf(200) // quand le parté est pogné
  .gain(0.9)


// extra perc
$: stack( sound("break").splice(12, "[~][3 4][~ 5][~ 7]").cut(2)
  .fast(2)
  .speed(0.5)
  .gain(0.4),

  sound("vox").chop(8).speed(3)
  .orbit(2).room(0.9)
  .dist(2).distorttype("sinefold")
  .gain(0.4))
  .degradeBy(0.8).crush(7)


$: sound("bd bd [bd [~ bd]] [~ bd]").bank("Rolandtr909")
  .speed(0.3) // switch to 1 when bass is active
  .duckorbit(2).duckdepth(1) 
  .sometimes(x=>x.ply(2)) //for more fun, from 2 to 3 to 4 to 5 to infinity
  .gain(0.4)

$: n(rand.segment(8).range(0,5)).sound("vowels") // segment(8) to segment(16)
  .cut(2)
  .speed("2 3 2.4")
  //.slow(2)
  .often(x=>x.hpf(1000).delay(0.8).orbit(2))
  .gain(0.2)

