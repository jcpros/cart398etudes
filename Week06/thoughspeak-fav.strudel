$: sound("<[[bd:4 [~ bd:4]][~][~ bd:4?0.5][~]] [[bd:4 [~ bd:4]]*4]/5 >").bank("Rolandsystem100")
  .duckorbit("1:2").duckattack(0.1).duckdepth(1)
  .speed("[0.5|0.3]").slow(2)

