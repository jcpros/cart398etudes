$: sound("[~][~][sd:9|[sd:9*4 sd:11*3]|[sd:9 ~ sd:9*2]][~]").bank("Rolandtr808")
  .sometimes(x=>x.orbit(3).delay(0.2).dt(0.2).dfb(0.5).pan(rand.range(1,0).speed(sine.segment(16).range(-1,4)))) // this ruined it in the best way ,i have no idea when snare hits will occur

$: note("<[d#3,f#4,b4] [a3,g3,d3] [d3,f#3,b4]!2>").sound("user").partials([1,0.5,1,0.5]).fm(4).fmh(2).adsr("0.3:0.4:1:0.3").noise(0.1)
  .crush(9)
  .lpf(1000)
  .roomsize(0.8)
  .room(2)
  .octave(-1)
  .tremolodepth(2).tremolosync("16")
  .slow(2)
  .orbit(2)
  .gain(0.2)



$: note("c2").sound("vox").speed(1).dist(2).begin("0.03").end("0.6")
  .cut(1).gain(0.1)

