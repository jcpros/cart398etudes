//@title first tableau
//@by clarence


//blue demon
osc(10,3,0.2).pixelate(100,100)
  .color(0,0.4,0.7)
  .scale(()=>0.4*Math.sin(time)+2, 1, 1, 0.3, ()=> Math.sin(time/3))
  .out(o0)


//phase shapes
shape([2.4,2.1,1.6,0.3].fast(3),0.2, () => Math.sin(time*2))
  .color(0.4,0.,0.1)
  .out(o1)

//primitive shapes
shape([2,1,4].fast(3),0.3,0).scale(0.3,1/1).repeatX(5)
  //.scrollX(0.2,-0.6)
 .color(0.5,0.7,0.1)
  .out(o2)

//particles
voronoi(100,0.9,0.8).thresh(0.5,0.3)
  .scale(10)
   .pixelate(0.8,100)
  .repeatY(100).modulateRepeatY(noise(),4, 0.2).out(o3)


render()
