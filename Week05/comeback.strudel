//@title comeback 
//@by clarence


samples({
  water: ['https://cdn.freesound.org/previews/237/237263_2394766-lq.mp3',
         'https://cdn.freesound.org/previews/237/237264_2394766-lq.mp3'], 
  //https://freesound.org/people/carlmartin/sounds/237264/
  imp: ['https://cdn.freesound.org/previews/829/829908_13183432-lq.mp3',
       'https://cdn.freesound.org/previews/660/660768_5334162-lq.mp3'],
  //https://freesound.org/people/JW_Audio/sounds/829908/
  //https://freesound.org/people/MadPanCake/sounds/660768/

  shine: 'https://cdn.freesound.org/previews/504/504609_7704891-lq.mp3',
   //https://freesound.org/people/NeoSpica/sounds/504609/
  chimes: 'https://cdn.freesound.org/previews/423/423492_7586736-lq.mp3',
    //https://freesound.org/people/swordofkings128/sounds/423492/ 
   whisper: 'https://cdn.freesound.org/previews/503/503270_10089976-lq.mp3'
  //https://freesound.org/people/LadyImperatrix/sounds/503270/

})

setcps(100/60/4)

$: note("60?0.7").sound("water").speed(0.6).slow(2)
  .room(2)
  .gain(0.5)

$: note("10@5 1?0.5").sound("shine").noise(0.2).speed(2)
  .slow(10)
  .hpf("1000")
  .roomsize(3).room(0.5).orbit(1)
  .gain(0.9)


$: note("60@3").sound("imp")
  .speed("-0.5")
  .lpf(1000).clip(0.4)
  .slow(3)
  .gain(0.8)
  .sometimes(x=>x.speed(-1).dist(3).hpf(500).pan(rand.range(0,1)).gain(0.1))

$: note("[20|10|13]@4").sound("chimes").chop(10)
  .adsr("0.2:0.6:1:2")
  .speed(0.3)
  .orbit(2).delay(0.8).dfb(0.9).dt(0.01)
  .often(x=>x.speed(0.9).phaser(0.3))
  .gain(0.9)

$: sound("[[[bd:1 bd:1 ~], [~ cp:5]]|[bd:8*3]]").bank("Rolandtr808")
  .dist(4).orbit(2).room(0.3).roomsize(2).lpf(3000).gain(0.13)
  .fast(2).every(4,x=>x.struct("x(5,8)").speed(0.7).clip(0.6))
  //.gain(0.4)


$: sound("whisper").note("50").speed("<-1 -0.5 [0.43 0.5] [1 1.3]>")
  .begin(0.2).end(0.8)
  .often(x=>x.chop(10).orbit(2).delay(0.5).pan(rand.range(0,1)).fast(4).clip(0.5))
  .slow(2)
  .gain(1.5)