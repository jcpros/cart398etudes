//@title bluebird
//@by clarence

s0.initImage("https://cdn.shopify.com/s/files/1/0782/9346/7416/files/European_roller_480x480.png")

src(s0).scale(1,9/16).scrollX(1,0.2).repeat(2,1).out(o0)


src(o1).modulate(osc(5).mult(noise(1)), 0.2).blend(src(o0).saturate(2), 0.1).out(o1)

solid(0.6,0.6,0.67).add(src(o1), 0.5).out(o2)

render(o2)