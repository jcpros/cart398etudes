//@title load
//@by clarence

samples('github:jcpros/samples')
samples({  imp: 'https://cdn.freesound.org/previews/842/842531_4369435-hq.mp3'})



setcps(110/60/4)

$: note("<4,[9]>(3,8, <0, 0 0, 1>)").adsr("0.01:0.3:0:0").hpf("1000").s("particles").speed("<0.5 0.4!2 [0.3|0.7]!2>").gain(0.8).vowel("a <e i> o")

$: note("<4,6,8>(5,8, <0 2, 0 1>)").adsr("0.01:0.3:0:0").lpf("1200").s("particles:1").speed("1.26").pan(sine.segment(16)).gain(0.6)

$: note("[<d1 e1 f#1 g1>]")
  //.adsr("0.2:0.8:1:1")
  .delay(0.4)
  .speed("0.5").sound("bass:3").adsr("0:0.9:1:.2").lpf(sine.range(100,3000))
  .dist("3").gain(0.07)

$: sound("bleep:3|bleep:2|bleep:5").often(x=>x.speed("<3.4 2>").ply(3)).degradeBy(0.2).delay("0.7").slow(3).gain("0.3")

$: note("100 ~ 400@3?0.6").sound("user").partials([1]).noise("0.9").adsr("0:0.4|0.1:1|0.2:2").hpf("4000").roomsize(5).room(0.6)

$: note("3.1@2|1.3 2.8@3|7.9*2 <6.4 5 1 [1 2 3]?0.8>").sound("user").scale("d6:lydian").partials("[1,0,0,0]").adsr("0.8:0.1:1:0.5").fm(0.3).fmh(1.3).slow(4).gain("0.02")
