//@title pico
//@by clarence
samples('github:jcpros/samples')
samples({  imp: 'https://cdn.freesound.org/previews/842/842531_4369435-hq.mp3'})


setcps("140/60/4")

 perc: stack(
  note("[1*2] [<2(3,8) 2*6>][[5|100*2] 4?0.6][~ <4 5*2>]?0.7").sound("pink").adsr("0:<0.01 0.04>:0:0").bpf("3000|6000").dist(1.6).gain("0.9"), 
  n("[~ 1]|[~!2 [7,8] [7,11]]").sound("user").partials([1]).adsr("0:0.2:0:0").noise("0.2|0.3").chunk(4,x=>x.ply(2))
   .scale("d3:persian").often(x =>x.adsr("0:0.3:0:0").fmh(1.1).fm(0.3).room(1.5).roomsize(0.8).delay(0.8).pan(sine.segment(16)))
   .gain("0.8")
  )

bass: stack(
   n("[[1][1*3][1!2|1!4][3]/2]/3").sound("user").partials([1]).adsr("0:<0.3>:0:0").dist(2).gain("0.5").every(6, x =>x.adsr("0.1:0.2:1:0")).cut(1), 
   n("[~][<[3|5]!6 [4@3]>]").sound("user").partials([1,0.3,0.4]).adsr(["0:0.6:0:0"]).noise(0.2)
   //.scale("d2:persian")
   .scale("d2:persian")
   //.delay(0.6)
   //.fast(4)
   .dist(5).gain(0.007).cut(1)
)
  //.degradeBy(0.3)

syn: stack(
  note("[8|9 6*4?0.2 ~!2 10?0.5]").sound("noisyn").striate(5).cut(1).speed("<[2 4] 1.3 1 1.6>").crush(7).gain(0.7).slow(2).hpf(rand.range(200,1000)).often(x=>x.room(1.5).roomsize(1.3))