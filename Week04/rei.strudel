//@title rei
//@by clarence



samples({
  crash:['https://cdn.freesound.org/previews/807/807437_3797507-lq.mp3',
         'https://cdn.freesound.org/previews/592/592388_11537497-lq.mp3'],
  mach: 'https://cdn.freesound.org/previews/629/629029_6512938-lq.mp3',
  body: 'https://cdn.freesound.org/previews/425/425150_3704754-lq.mp3',
  amen: 'https://cdn.freesound.org/previews/260/260050_450294-lq.mp3',
  pad: 'https://cdn.freesound.org/previews/497/497480_10350281-hq.mp3'
  //https://freesound.org/people/JohnLaVine333/sounds/260050/
  //https://freesound.org/people/Logicogonist/sounds/807437/
  //https://freesound.org/people/magnuswaker/sounds/592388/
  //https://freesound.org/people/commercialkings/sounds/629029/
  //https://freesound.org/people/tailorvj/sounds/425150/
})

samples('github:jcpros/samples')

setcps(100/60/4)



bass: note("[<1 3 2 5>(3,8)]").sound("user").partials([1]).adsr("0:0.4:0:0")
  .scale("g2:pelog").echo(3,1/4,.8)

melo: note("<2 3 1 5>(3,8)").sound("user").partials([1]).adsr("0.1:0.5:0:0")
  .scale("g3:pelog").echo(3,1/3,.8).gain("0.5")

fastMelo: note("<2 3?0.5 1 5>(3,8)").sound("user").partials([1]).adsr("0:0.5:0:0")
  .scale("g4:pelog").fast(2).gain("0.5").pan(rand.range(0.2,0.8)).often(x=>x.ply(3).rev().delay(0.3))

stab: note("<[2,3] [3,5] [1,4] [5,7]>(3,8)").sound("user").partials([1,0.1,0.2,0.7]).adsr("0.2:0.8:0:0")
.scale("g2:pelog").gain("0.2").hpf(1000)

