//@title god-fearing 
//@by clarence

setcps(150/60/4)

samples({
  icepac: 'https://cdn.freesound.org/previews/399/399906_2402876-lq.mp3',
  break:'https://cdn.freesound.org/previews/260/260050_450294-lq.mp3',
  imp: 'https://cdn.freesound.org/previews/842/842531_4369435-hq.mp3'
})
$: note("d1").sound("sawtooth").partials([1,0,1,0,1]).noise(0.1)
.adsr("0:0.2:0:0")
.struct("x(<3,5>,8,<0,0,1>)").every(6,x=>x.slow(2)).gain(0.4)

$: note("c7 e8?0.78").sound("sine").adsr("0:<0.2 0.3>:0:0").fm(4).fmh(2).fmdecay(0.4)
.struct("[~ ~ [x*2|x*4] ~]*2").phaser(2).gain(0.2).phasercenter("<400 500>")

$: sound("break").splice(8,"1 1 [3 4] 3").cut(2).dist("2.7").gain(0.06).speed(0.1)

$: note("25 25 [26 27]").sound("icepac,imp").adsr("0.3:0.9:0:0").gain("0.1").speed("1").hpf(1000).room("2.8").roomsize("0.6")