//@title incidence
//@by clarence

setcps(120/60/4)

$: note("[7 ~] [9*3]/3").sound("user").partials([1,1,1,"<0.5 1 5>", 0.3]).adsr(".01:.2:0.1").fast("<[2 4] 3?0.3 5/3>")

$: note("[<[e4 c4] e5*5/3>(<3 5>,8,<0 2 1>)]*2").sound("user").partials([1]).noise("0.9").adsr("0:0.02:0"). gain(0.13)

$: note("<30 25 22@2?0.7> ~").sound("user").partials(randL(10)).gain("0.2").adsr("0.2:0.4:1:3").lpf(500).room(0.5)

$: note("100").sound("user").partials([1]).noise("0.9").adsr("0:0.4|0.1:1|0.2:2").hpf("1000").gain(0.1).delay(0.3).pan("<0.4 0.5 0.9>")