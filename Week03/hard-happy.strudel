// @title hard-happy
// @by clarence


samples({
  imp: 'https://cdn.freesound.org/previews/842/842531_4369435-hq.mp3',
  //https://freesound.org/people/TannerSound/sounds/842531/
  amen: 'https://cdn.freesound.org/previews/260/260050_450294-lq.mp3',
  //https://freesound.org/people/JohnLaVine333/sounds/260050/
  pad: 'https://cdn.freesound.org/previews/497/497480_10350281-hq.mp3',
  choir: 'https://cdn.freesound.org/previews/578/578327_10522382-lq.mp3'
})
setcps(140/60/4)



$: sound("amen").slice(8, "[0 3 [1 5] <6*2 [7*3 6]/3> ]*2").crush("12").cut(1).gain("0.4").speed("<0.7 [1.6|-0.6]>")
  .slow(2)
//$: sound("imp").splice(8, "[2 2!5 2 <[2 4] 4*4>]").gain(0.07).cut(2).hpf("700").speed("<0.3 -0.6>")
$: sound("choir").scrub("{0.1:2 [[0.5:0.9 0.3] <0.2 0.3:0.79>]}").gain("0.2").hpf("1300").speed(1).delay(0.3).fast(2)