samples({
  lead: ['https://cdn.freesound.org/previews/324/324040_29308-hq.mp3','https://cdn.freesound.org/previews/299/299934_2050105-lq.mp3'],
  git: 'https://cdn.freesound.org/previews/799/799008_16840242-hq.mp3',
  //https://cdn.freesound.org/previews/299/299934_2050105-lq.mp3
